# Local PostgreSQL (the root Docker Compose file exposes PostgreSQL on port 55432)
DATABASE_URL="postgresql://portfolio:portfolio_local_password@localhost:55432/portfolio_backend?schema=public"
PORT=5000
HOST="0.0.0.0"
NODE_ENV="development"

# Use a long, random value in every environment.
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_INACTIVITY_TIMEOUT_MS=300000

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS="http://localhost:3000"

